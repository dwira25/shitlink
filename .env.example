# Backend Configuration
PORT=3001
NODE_ENV=production

# Database
DATABASE_URL="file:./dev.db" # SQLite for development, use PostgreSQL for production

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# App
APP_ORIGIN="http://localhost:5173"
APP_DOMAIN="localhost"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100 # per window per IP

# Security
CSRF_SECRET="your-csrf-secret-key-change-this"

# Admin Bootstrap (for initial setup)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123"

# Vercel Environment (for production)
# Uncomment and set these in Vercel dashboard
# DATABASE_URL="postgresql://..."
# JWT_SECRET="..."
# APP_ORIGIN="https://yourdomain.vercel.app"
# APP_DOMAIN="yourdomain.vercel.app"